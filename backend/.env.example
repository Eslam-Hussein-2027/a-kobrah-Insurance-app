APP_NAME="Kobrah Insurance API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=car_insurance
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum personal access token lifetime in minutes (43200 = 30 days). Empty = never expires.
SANCTUM_EXPIRATION=43200

# ------------------------------------------------------------------ Insurance domain
INSURANCE_CURRENCY=EGP
INSURANCE_CURRENCY_LABEL="جنيه مصري"
COMPANY_NAME_AR="شركة الكبرى للتأمين"
COMPANY_NAME_EN="Al Kobrah Insurance Co."
COMPANY_ADDRESS="القاهرة - جمهورية مصر العربية"
COMPANY_PHONE=19000
# Absolute paths to the real logo / stamp images (PNG, JPG or SVG). Defaults: resources/pdf/*.svg placeholders
#COMPANY_LOGO_PATH=
#COMPANY_STAMP_PATH=
POLICY_VERIFICATION_URL="${APP_URL}/verify"

POLICY_DURATION_MONTHS=12
POLICY_MAX_START_DAYS_AHEAD=60
QUOTE_CLAIMS_HISTORY_YEARS=3

# OTP / SMS
SMS_DRIVER=log
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Local development only (ignored unless APP_ENV is local/testing). Leave empty to use random codes.
OTP_FIXED_CODE=123456

UPLOAD_IMAGE_MAX_KB=5120
SIGNED_URL_TTL_MINUTES=15
